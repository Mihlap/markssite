FROM node:18-alpine

LABEL version="1.0.0"

WORKDIR /server/

RUN apk update && apk add postgresql-client

COPY package*.json /server/

RUN npm cache clean --force
RUN npm install
RUN npm install bcrypt

COPY . /server/

EXPOSE 3002

RUN npm run start

# Если вам нужно указать какой-то команды для запуска приложения (например, для сервера статических файлов)
CMD ["npm", "start"]
