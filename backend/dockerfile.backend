FROM node:18-alpine

LABEL version="1.0.0"

WORKDIR /app

RUN apk update && apk add postgresql-client

COPY package*.json ./

RUN npm cache clean --force
RUN npm install
RUN npm install bcrypt

COPY . .

EXPOSE 3002

RUN npm run build

# Если вам нужно указать какой-то команды для запуска приложения (например, для сервера статических файлов)
CMD ["npm", "start"]
