FROM node:18-alpine

LABEL version="1.0.0"

WORKDIR /frontend/

# Установка serve для статического сервера
RUN npm install -g serve

# Аргументы сборки для переменных окружения
ARG REACT_APP_SERVER_HOST=http://localhost:3002
ARG REACT_APP_API_URL=http://localhost:3002
ARG REACT_APP_S3_BUCKET_URL

# Установка переменных окружения для сборки
ENV REACT_APP_SERVER_HOST=${REACT_APP_SERVER_HOST}
ENV REACT_APP_API_URL=${REACT_APP_API_URL}
ENV REACT_APP_S3_BUCKET_URL=${REACT_APP_S3_BUCKET_URL}
ENV NODE_ENV=production

COPY package*.json ./

RUN npm install

COPY . .

RUN npm run build

# Используем serve для обслуживания статических файлов
CMD ["serve", "-s", "build", "-l", "3000"]

